# EduFocus🌙 — modèle d'environnement. Copier vers .env pour configurer le projet.
# Ces valeurs correspondent aux défauts actuellement codés en dur dans le code ;
# aucune d'entre elles n'est encore lue par le code (documentées pour la config future).

# ── Backend (FastAPI) ─────────────────────────────────────────────
# Port de l'API : uvicorn backend.api.main:app --reload --port $PORT
PORT=8000
# Répertoire des données analytiques pré-calculées
DATA_PATH=data/processed

# ── Frontend (Vite) ───────────────────────────────────────────────
# Port du serveur de dev Vite (frontend/)
VITE_PORT=5173
# Cible du proxy /api (défaut codé en dur dans frontend/vite.config.ts)
API_TARGET=http://127.0.0.1:8000
